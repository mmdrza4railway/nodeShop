<%- include('./layout/start.ejs') %>
<%- include('./layout/nav.ejs') %>

<div id="carouselExampleIndicators" class="carousel slide container">
    <div class="carousel-indicators">
        <button
            type="button"
            data-bs-target="#carouselExampleIndicators"
            data-bs-slide-to="0"
            class="active"
        ></button>
        <button
            type="button"
            data-bs-target="#carouselExampleIndicators"
            data-bs-slide-to="1"
        ></button>
        <button
            type="button"
            data-bs-target="#carouselExampleIndicators"
            data-bs-slide-to="2"
        ></button>
    </div>

    <div class="carousel-inner">
        <div class="carousel-item active">
            <img
                src="/public/images/Man_relaxing_in_living_room_202607271540.webp"
                class="d-block w-100 h-100 object-fit-cover"
                alt="Man relaxing"
            />
        </div>

        <div class="carousel-item">
            <img
                src="/public/images/Woman_in_blazer_and_trousers_202607271540.webp"
                class="d-block w-100 h-100 object-fit-cover"
                alt="Woman"
            />
        </div>

        <div class="carousel-item">
            <img
                src="/public/images/Young_man_walking_corporate_hallway_202607271540.webp"
                class="d-block w-100 h-100 object-fit-cover"
                alt="Young man"
            />
        </div>
    </div>

    <button
        class="carousel-control-prev"
        type="button"
        data-bs-target="#carouselExampleIndicators"
        data-bs-slide="prev"
    >
        <span class="carousel-control-prev-icon"></span>
    </button>

    <button
        class="carousel-control-next"
        type="button"
        data-bs-target="#carouselExampleIndicators"
        data-bs-slide="next"
    >
        <span class="carousel-control-next-icon"></span>
    </button>
</div>

<section class="container py-5">
    <% if (success) { %>
        <div class="alert alert-success text-center" role="alert">
            <%= success %>
        </div>
    <% } %>
    <% if (warn) { %>
        <div class="alert alert-warning text-center" role="alert">
            <%= warn %>
        </div>
    <% } %>

    <h2 class="text-center fw-bold mb-5">جدیدترین محصولات</h2>

    <div class="row g-4">
        <!-- Product -->
        <% if (products && products.length > 0) {
            products.forEach(product => { %>
               <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                   <div class="card h-100 shadow-sm">
                       <img src="/public/products/<%= product.image %>" class="card-img-top product-img" alt="Product" />
       
                       <div class="card-body d-flex flex-column">
                           <h5 class="card-title product-title">
                                <%= product.title %>
                           </h5>
       
                           <p class="card-text product-desc">
                                <%= product.desc %>
                           </p>
       
                           <h4 class="text-success fw-bold mt-auto mb-3">
                               <%= product.price !== 0 ? product.price.toLocaleString('fa-IR') + " تومان" : "رایگان" %>
                           </h4>
       
                           <div class="d-grid gap-2">
                               <form action="/cart/add/<%= product._id %>" method="post">
                                    <button type="submit" class="btn btn-primary w-100">
                                        افزودن به سبد خرید
                                    </button>
                                </form>
       
                               <a href="/products/view/<%= product._id %>" class="btn btn-outline-secondary">
                                   جزئیات
                               </a>
                           </div>
                       </div>
                   </div>
               </div>
            <% }) } else { %>
                <h5 class="text-center">محصولی برای نمایش وجود ندارد</h5>
          <% } %>
    </div>

    <div class="text-center mt-5">
        <a href="/products" class="btn btn-outline-primary btn-lg px-5 rounded-pill">
            مشاهده همه محصولات
        </a>
    </div>
</section>

<%- include('./layout/footer.ejs') %>
<%- include('./layout/end.ejs') %>
